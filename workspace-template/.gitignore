# Copied into a workspace when it is created, and never tracked by the line
# repository. The same list is written to .git/info/exclude, so one bad edit to a
# tracked file cannot expose the source history.
#
# It lists itself, because an untracked file that shows up in git status is an
# untracked file somebody eventually commits by accident.
#
# /handoff/ is here because the ledger is its own repository: the line tracks
# doc/ and nothing else.

.gitignore

/.bare/
/store/
/handoff/
/var/
/job/
/worktree/
